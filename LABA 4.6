#include <iostream>
#include <cmath>

using namespace std;

int main()
{
	double T, S;
	int i, k;

	//  while
	T = 0;
	i = 1;
	while (i <= 12)
	{
		S = 0;
		k = 1;
		while (k <= i)
		{
			S += sin(1. * k);
			k++;
		}
		T += pow(1 + S, 2) / (cos(1. * i) + pow(S, 2));
		i++;
	}
	cout << T << endl;

	//  do-while
	T = 0;
	i = 1;
	do {
		S = 0;
		k = 1;
		do {
			S += sin(1. * k);
			k++;
		} while (k <= i);
		T += pow(1 + S, 2) / (cos(1. * i) + pow(S, 2));
		i++;
	} while (i <= 12);
	cout << T << endl;

	//  for (вгору)
	T = 0;
	for (i = 1; i <= 12; i++)
	{
		S = 0;
		for (k = 1; k <= i; k++)
		{
			S += sin(1. * k);
		}
		T += pow(1 + S, 2) / (cos(1. * i) + pow(S, 2));
	}
	cout << T << endl;

	// for (вниз)
	T = 0;
	for (i = 12; i >= 1; i--)
	{
		S = 0;
		for (k = i; k >= 1; k--)
		{
			S += sin(1. * k);
		}
		T += pow(1 + S, 2) / (cos(1. * i) + pow(S, 2));
	}
	cout << T << endl;

	return 0;
}
